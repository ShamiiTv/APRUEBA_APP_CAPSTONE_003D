PORT=4000
FIREBASE_PROJECT_ID=demo-aprueba
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Usa dos secretos aleatorios distintos. No publiques los valores de .env.
JWT_SECRET=
JWT_REFRESH_SECRET=
# En producción, elimina las variables de emulador y usa la clave web del proyecto.
FIREBASE_WEB_API_KEY=

# Solo demostraciones explícitas: no cobra dinero ni genera boletas.
PAYMENTS_MODE=simulation

# Optional: replace simulation with paypal-sandbox. Live payments are not implemented.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_UNI=
PAYPAL_PLAN_ALL=
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_ORIGIN=http://localhost:5179

# Arena: enable only after deploying the worker and both clients.
ARENA_ENABLED=false
# Pause new searches while allowing current matches to finish.
ARENA_ACCEPTING=true
